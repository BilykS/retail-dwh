---
import Base from '~/layouts/Base.astro';
import HowNav from '~/components/HowNav.astro';
import Ledger from '~/components/Ledger.astro';
import { type Locale, localePath } from '~/i18n';
import { formatter } from '~/lib/format';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const fmt = formatter(lang);

const COPY = {
  en: {
    title: 'Results',
    description: 'Reconciliation of two implementations, dbt tests, star against snowflake measurements and what reconciliation cannot catch.',
    eyebrow: 'Results',
    heading: 'What was checked, what was measured, and what reconciliation misses',

    recon: 'Reconciling two implementations',
    reconText: 'Manual SQL and dbt produce the same totals.',
    schema: 'Schema',
    rows: 'Rows',
    difference: 'difference',

    tests: 'dbt tests',
    singular: 'singular',
    testsTotal: 'PASS, ERROR=0',
    testsNote: 'dbt does not create foreign keys, so <code>relationships</code> tests check the links between facts and dimensions. Last run 2026-11-06.',

    limitLabel: 'What reconciliation missed',
    limitHeading: 'Margin used to be calculated at today’s cost',
    limitText: `Receipt lines hold no cost at the time of sale, and both implementations used the current <code>products.unit_cost</code>. It changed for 133 products, which affected ${fmt.int(8794)} fact rows. The table above still showed zero, because the formula was the same in both. Cost now comes from the <code>src.product_changes</code> log for the date of the sale. It is ${fmt.dec(20985252.87, 2)} UAH (${fmt.dec(0.72, 2)}%) lower, and margin is ${fmt.dec(33.44, 2)}% instead of ${fmt.dec(32.96, 2)}%.`,
    limitNote: 'The two implementations now get this cost in different ways: a CTE with a date range in the manual ETL, and a separate model in dbt. So the reconciliation checks this rule as well.',

    bench: 'Star or snowflake',
    benchText: 'The same sales in two schemas and the same queries. <code>EXPLAIN ANALYZE</code>, warm cache, median of 41 runs.',
    benchTitle: 'Every extra join costs time, while normalised dimensions save almost no space',
    joins: (a: number, b: number) => `joins: ${a} against ${b}`,
    queries: ['Revenue by region', 'Revenue by category', 'Top 20 products'],
    benchNote: 'The fact table accounts for 95 to 98% of the pages read, so normalising dimensions saves about 1% of the space. The 3% on the last query is within run-to-run noise. I chose the star as the base schema. The <code>snow</code> schema exists only for this comparison, so its cost still uses the old formula. These queries read revenue only.',

    analytics: 'Analytics',
    analyticsText: `The query set in <a href="https://github.com/BilykS/retail-dwh/tree/main/04_practice">04_practice</a>: year over year, top N in a category, running totals and ABC analysis (552 of ${fmt.int(2000)} products bring 80% of revenue). The charts are in the <a href="/report">report</a>.`,
    next: 'Open the report',
  },
  uk: {
    title: 'Результати',
    description: 'Звірка двох реалізацій, тести dbt, виміри зірки проти сніжинки і те, чого звірка не ловить.',
    eyebrow: 'Результати',
    heading: 'Що перевірено, виміряно і чого звірка не ловить',

    recon: 'Звірка двох реалізацій',
    reconText: 'Ручний SQL і dbt дають однакові суми.',
    schema: 'Схема',
    rows: 'Рядків',
    difference: 'різниця',

    tests: 'Тести dbt',
    singular: 'власний тест',
    testsTotal: 'PASS, ERROR=0',
    testsNote: 'dbt не створює зовнішніх ключів, тому зв’язки між фактами й вимірами перевіряють тести <code>relationships</code>. Останній прогін 2026-11-06.',

    limitLabel: 'Що звірка пропустила',
    limitHeading: 'Маржа рахувалась за сьогоднішньою собівартістю',
    limitText: `У позиціях чека немає собівартості на момент продажу, і обидві реалізації брали поточну <code>products.unit_cost</code>. Для 133 товарів вона змінювалась, це зачіпало ${fmt.int(8794)} рядки факту. Таблиця вище все одно показувала нуль, бо формула в них була однакова. Тепер собівартість береться з журналу <code>src.product_changes</code> на дату продажу. Вона на ${fmt.dec(20985252.87, 2)} грн (${fmt.dec(0.72, 2)}%) нижча, а маржа становить ${fmt.dec(33.44, 2)}% замість ${fmt.dec(32.96, 2)}%.`,
    limitNote: 'Тепер реалізації отримують цю собівартість по-різному: CTE з діапазоном дат у ручному ETL і окрема модель у dbt. Тому звірка перевіряє і це правило.',

    bench: 'Зірка чи сніжинка',
    benchText: 'Ті самі продажі в двох схемах і ті самі запити. <code>EXPLAIN ANALYZE</code>, прогрітий кеш, медіана 41 прогону.',
    benchTitle: 'Кожен зайвий join коштує часу, а місця в нормалізованих вимірах майже не економиться',
    joins: (a: number, b: number) => `join’ів: ${a} проти ${b}`,
    queries: ['Виручка за областю', 'Виручка за категорією', 'Топ-20 товарів'],
    benchNote: 'На таблицю фактів припадає 95-98% прочитаних сторінок, тому нормалізація вимірів економить близько 1% місця. 3% на останньому запиті в межах шуму між прогонами. За базову схему я взяв зірку. Схема <code>snow</code> існує лише для цього порівняння, тому її собівартість рахується за старою формулою. Ці запити читають лише виручку.',

    analytics: 'Аналітика',
    analyticsText: `Набір запитів у <a href="https://github.com/BilykS/retail-dwh/tree/main/04_practice">04_practice</a>: рік до року, топ-N у категорії, наростаючі підсумки, ABC-аналіз (552 із ${fmt.int(2000)} товарів дають 80% виручки). Графіки зібрані у <a href="/uk/report">звіті</a>.`,
    next: 'Відкрити звіт',
  },
}[lang];

// Median milliseconds over 41 runs of 02_snowflake/compare.sql.
const BENCH = [
  { star: 51, snow: 85, joins: [1, 3], diff: '+67%' },
  { star: 56, snow: 75, joins: [1, 2], diff: '+32%' },
  { star: 61, snow: 63, joins: [1, 1], diff: '+3%' },
];
const BENCH_MAX = 85;
const barWidth = (ms: number) => `width: calc((100% - 7.25rem) * ${(ms / BENCH_MAX).toFixed(4)})`;

const NET = fmt.dec(4375145993.13, 2);
const COST = fmt.dec(2912024151.08, 2);
---

<Base title={COPY.title} description={COPY.description} lang={lang}>
  <div class="shell page">
    <HowNav lang={lang} />
    <header class="flex flex-col gap-3.5">
      <p class="label">{COPY.eyebrow}</p>
      <h1 class="display display-2">{COPY.heading}</h1>
    </header>

    <div class="grid gap-8 md:grid-cols-2 md:gap-12">
      <section class="flex flex-col gap-4">
        <h2 class="display display-3">{COPY.recon}</h2>
        <p class="body">{COPY.reconText}</p>
        <div class="scroll-x">
          <table class="table min-w-[27.5rem]">
            <thead>
              <tr><th>{COPY.schema}</th><th class="n">{COPY.rows}</th><th class="n">net_amount</th><th class="n">cost_amount</th></tr>
            </thead>
            <tbody>
              <tr><td>star</td><td class="n">{fmt.int(233015)}</td><td class="n">{NET}</td><td class="n">{COST}</td></tr>
              <tr><td>dbt_star</td><td class="n">{fmt.int(233015)}</td><td class="n">{NET}</td><td class="n">{COST}</td></tr>
              <tr class="total"><td>{COPY.difference}</td><td class="n">0</td><td class="n">{fmt.dec(0, 2)}</td><td class="n">{fmt.dec(0, 2)}</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="flex flex-col gap-4">
        <h2 class="display display-3">{COPY.tests}</h2>
        <Ledger rows={[
          { label: 'not_null', value: '41' },
          { label: 'unique', value: '17' },
          { label: 'relationships', value: '11' },
          { label: 'accepted_values', value: '6' },
          { label: COPY.singular, value: '1' },
          { label: COPY.testsTotal, value: '76', kind: 'sum' },
        ]} />
        <p class="note" set:html={COPY.testsNote} />
      </section>
    </div>

    <section class="limit">
      <p class="label">{COPY.limitLabel}</p>
      <h2 class="display display-3">{COPY.limitHeading}</h2>
      <p class="body" set:html={COPY.limitText} />
      <p class="body">{COPY.limitNote}</p>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="display display-3">{COPY.bench}</h2>
      <p class="body" set:html={COPY.benchText} />
      <p class="max-w-[62ch] font-semibold text-balance">{COPY.benchTitle}</p>
      <div class="flex gap-4 text-sm text-ink-2">
        <span class="flex items-center gap-1.5"><i class="key bg-ink"></i>star</span>
        <span class="flex items-center gap-1.5"><i class="key bg-ink-3"></i>snow</span>
      </div>
      <div class="flex flex-col gap-4">
        {BENCH.map((b, i) => (
          <div>
            <div class="flex flex-wrap justify-between gap-x-3 pb-1 font-semibold">
              <span>{COPY.queries[i]}</span>
              <span class="text-sm font-normal text-ink-2">{COPY.joins(b.joins[0], b.joins[1])}</span>
            </div>
            <div class="bench-row"><span class="bench-name">star</span><span class="bench-track"><span class="bench-bar bg-ink" style={barWidth(b.star)}></span><span class="bench-value">{b.star} ms</span></span></div>
            <div class="bench-row"><span class="bench-name">snow</span><span class="bench-track"><span class="bench-bar bg-ink-3" style={barWidth(b.snow)}></span><span class="bench-value">{b.snow} ms, {b.diff}</span></span></div>
          </div>
        ))}
      </div>
      <p class="note" set:html={COPY.benchNote} />
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="display display-3">{COPY.analytics}</h2>
      <p class="body" set:html={COPY.analyticsText} />
    </section>

    <p class="next-link"><a class="link" href={localePath(lang, '/report')}>{COPY.next}</a></p>
  </div>
</Base>

<style>
  /* One of the few places colour is allowed: this block says "be careful". */
  .limit {
    background: var(--warn-wash);
    border-top: 3px solid var(--data-2);
    padding: 1.25rem 1.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .key { display: inline-block; width: 0.6875rem; height: 0.6875rem; }

  .bench-row { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); gap: 0.75rem; align-items: center; padding-block: 0.125rem; }
  .bench-name { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-2); text-align: right; }
  .bench-track { display: flex; align-items: center; gap: 0.5rem; }
  .bench-bar { height: 0.8125rem; border-radius: 0 3px 3px 0; flex: none; }
  .bench-value { font-family: var(--font-mono); font-size: 0.78125rem; white-space: nowrap; font-variant-numeric: tabular-nums; }

  .next-link { display: flex; justify-content: flex-end; font-family: var(--font-display); font-size: 1.375rem; }
</style>
