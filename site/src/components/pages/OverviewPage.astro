---
import Base from '~/layouts/Base.astro';
import Receipt from '~/components/Receipt.astro';
import MarginChart from '~/components/MarginChart.astro';
import SqlDetails from '~/components/SqlDetails.astro';
import insights from '~/data/insights.json';
import { type Locale, localePath, t } from '~/i18n';
import { formatter } from '~/lib/format';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const fmt = formatter(lang);

// Every figure in the answers below comes from insights.json, which is generated
// by the same queries the page prints.
const [y2024, y2025] = insights.margin;
const [first2024, first2025] = insights.priceEffect;
const [current2024, current2025] = insights.currentCost;
const { discount, products, formats, season, priceChanges } = insights;

const pct = (n: number, digits = 2) => `${fmt.dec(n, digits)}%`;
const millions = (n: number) => fmt.dec(Math.abs(n) / 1e6, 1);

const revenueGrowth = fmt.dec((y2025.revenue / y2024.revenue - 1) * 100, 1);
const marginFall = millions(y2025.margin - y2024.margin);
const marginFallPp = fmt.dec(y2024.pct - y2025.pct, 2);
const costAdded = millions(first2025.costAdded);
const totalProducts = products.a + products.b + products.c;
const discountedShare = Math.round((discount.with.lines / (discount.with.lines + discount.without.lines)) * 100);
const season2025 = season[1].pct;
const perStore = formats.map((f) => millions(f.perStore)).join(' / ');

// Page copy lives here rather than in the UI dictionary: it is prose, and prose
// is easier to keep honest when the two languages sit side by side.
const COPY = {
  en: {
    title: 'Overview',
    description: 'A retail data warehouse that brings sales and stock into one model, keeps the history of prices and categories, and gives every report one definition of revenue.',
    lede: 'A data warehouse for a retail chain. It brings sales and stock into one model, keeps the history of prices and categories, and gives an analyst one definition of revenue across every report.',
    note: 'The chain is fictional and the data is generated by a script. The generator is deterministic, so every figure can be reproduced. The findings below show what the warehouse can answer, not the results of a real company.',

    solvesTitle: 'What this warehouse solves',
    solvesIntro: 'The chain’s operational systems handle sales and stock movements well, but it is hard to get a reliable answer out of them. There are four reasons.',
    colProblem: 'Problem',
    colDone: 'What was built',
    colGives: 'What it gives',
    problems: [
      {
        problem: 'Sales and stock live apart',
        why: 'The two systems use different product codes. 60 warehouse articles have no retail product, and 15 products have two warehouse cards.',
        done: 'Shared date and product dimensions, linked only from article to product.',
        gives: `Stock can be compared with the sales rate for 584 products, and rows do not multiply.`,
      },
      {
        problem: 'The source remembers only today',
        why: `Price, name and category get overwritten. Over two years that is ${priceChanges.count} price changes and 315 name or category changes.`,
        done: 'Name and category are versioned (SCD Type 2), and cost is taken as of the sale date.',
        gives: `Past reports no longer change after the fact. Margin is ${pct(33.44)}, not ${pct(32.96)}.`,
      },
      {
        problem: 'No single definition of revenue',
        why: `Cancellations and returns have to be handled by hand in every query. A <code>status = 'completed'</code> filter silently drops ${fmt.int(13146)} rows.`,
        done: 'One fact table at receipt-line grain. Cancelled orders stay out, and returns sit in it with a minus sign.',
        gives: 'Revenue is <code>sum(net_amount)</code>. Two independent builds match to the kopiyka.',
      },
      {
        problem: 'Every query starts with joins',
        why: 'The source is normalised into 11 tables. Revenue by region takes 3 joins and a status filter.',
        done: 'A star schema, with what reports need collected into dimensions.',
        gives: 'The same question takes 1 join, and the result matches in all 18 regions. Power BI connects to the tables directly.',
      },
    ],

    example: 'Main example',
    exampleTitle: `Revenue grew by ${revenueGrowth}%, but margin fell by ${marginFall} M UAH. Why?`,
    exampleText: `Supplier prices only moved up: ${priceChanges.rises} rises, ${fmt.dec(priceChanges.avgRisePct, 1)}% on average, which added ${costAdded} M UAH of cost in 2025. At the original prices, margin would have barely moved: ${pct(first2024.pctAtFirstCost)} in 2024 and ${pct(first2025.pctAtFirstCost)} in 2025. The actual figures are ${pct(y2024.pct)} and ${pct(y2025.pct)}.`,
    chartTitle: `With price history margin falls by ${marginFallPp} points. At today’s prices the fall almost disappears.`,
    chartNote: `Without price history both years are calculated at today’s cost, which gives ${pct(current2024.pct)} and ${pct(current2025.pct)}. The warehouse first worked that way too, and that error hid the fall. The two lines meet at the end because recent sales already carry today’s prices.`,

    exampleLink: 'See it in the report',
    questionsTitle: 'What else it answers',
    questions: {
      discount: {
        who: 'Commercial director',
        question: 'How much do discounts cost us?',
        answer: `${pct(discount.with.marginPct, 1)} vs ${pct(discount.without.marginPct, 1)}`,
        text: `Margin on discounted lines against the rest. ${discountedShare}% of lines carry a discount, ${fmt.dec(discount.with.discount / 1e6, 0)} M UAH in total. The data shows the lower margin, but not whether discounts pay off in extra sales. That would need a control period.`,
        report: 'See it in the report',
      },
      products: {
        who: 'Category manager',
        question: 'Which products actually earn money?',
        answer: `${fmt.int(products.a)} of ${fmt.int(totalProducts)}`,
        text: `That many products bring 80% of revenue. Another ${fmt.int(products.c)} bring only ${fmt.dec(products.cSharePct, 0)}%, so they are the first candidates for an assortment review.`,
      },
      formats: {
        who: 'Operations director',
        question: 'Which store formats perform best?',
        answer: `${perStore} M`,
        text: 'Revenue per store in 2025: standard, flagship, kiosk. Flagships earn less per store than standard stores.',
        report: 'See it in the report',
      },
      season: {
        who: 'Procurement',
        question: 'What should we prepare for in the season?',
        answer: pct(season2025, 1),
        text: 'The share of annual revenue that falls on November and December, two months out of twelve. Stock has to be in place before that.',
        report: 'See it in the report',
      },
    },

    howTitle: 'How a receipt becomes an answer',
    howText: 'Every receipt line becomes one row in the fact table, and its keys lead to the dimensions: date, product, store, customer. All the answers above are aggregates of these rows. Click a line on the receipt to see its row.',
    routesTitle: 'Go deeper',
    routes: [
      { path: '/report', title: 'Report', text: 'A dashboard with filters over the warehouse data: sales, margin, discounts, stock.' },
      { path: '/journey', title: 'Data journey', text: 'A 3D flight: threads carry the values of one receipt line from two systems into two stars.' },
      { path: '/how', title: 'How it is built', text: 'The model, the decisions behind the numbers, tests and reconciliation.' },
    ],
  },
  uk: {
    title: 'Огляд',
    description: 'Сховище даних для роздрібної мережі: зводить продажі й склад в одну модель, зберігає історію цін і категорій і дає всім звітам одне визначення виручки.',
    lede: 'Сховище даних для роздрібної мережі. Воно зводить продажі й склад в одну модель, зберігає історію цін і категорій і дає аналітику одне визначення виручки на всі звіти.',
    note: 'Мережа умовна, дані згенеровані скриптом. Генератор детермінований, тому всі цифри можна отримати повторно. Висновки нижче показують, на що здатне сховище, а не результати реальної компанії.',

    solvesTitle: 'Що вирішує це сховище',
    solvesIntro: 'Операційні системи мережі добре проводять продажі й рух товарів, але отримати з них надійну відповідь важко. Причин чотири.',
    colProblem: 'Проблема',
    colDone: 'Що зроблено',
    colGives: 'Що це дає',
    problems: [
      {
        problem: 'Продажі й склад живуть окремо',
        why: 'Системи мають різні коди товарів. 60 складських артикулів не мають роздрібного товару, а 15 товарів мають по дві складські картки.',
        done: 'Спільні виміри дати й товару, зв’язок лише від артикула до товару.',
        gives: 'Запас можна порівняти з темпом продажів для 584 товарів, і рядки не множаться.',
      },
      {
        problem: 'Джерело пам’ятає лише сьогодні',
        why: `Ціна, назва й категорія перезаписуються. За два роки це ${priceChanges.count} змін ціни і 315 змін назви чи категорії.`,
        done: 'Назва й категорія мають версії (SCD Type 2), а собівартість береться на дату продажу.',
        gives: `Минулі звіти більше не змінюються заднім числом. Маржа ${pct(33.44)}, а не ${pct(32.96)}.`,
      },
      {
        problem: 'Немає одного визначення виручки',
        why: `Скасування й повернення доводиться враховувати вручну в кожному запиті. Фільтр <code>status = 'completed'</code> мовчки прибирає ${fmt.int(13146)} рядків.`,
        done: 'Один факт із зерном «позиція чека». Скасовані в нього не входять, повернення лежать із мінусом.',
        gives: 'Виручка рахується як <code>sum(net_amount)</code>. Дві незалежні реалізації сходяться до копійки.',
      },
      {
        problem: 'Кожен запит починається з join’ів',
        why: 'Джерело нормалізоване, це 11 таблиць. Виручка за областю потребує 3 join’ів і фільтра за статусом.',
        done: 'Зіркова схема: те, що потрібно звітам, зібране у виміри.',
        gives: 'Те саме питання потребує 1 join’а, а результат збігається в усіх 18 областях. Power BI підключається до таблиць напряму.',
      },
    ],

    example: 'Головний приклад',
    exampleTitle: `Виручка зросла на ${revenueGrowth}%, а маржа впала на ${marginFall} млн грн. Чому?`,
    exampleText: `Закупівельні ціни змінювались лише вгору: ${priceChanges.rises} підвищення, у середньому на ${fmt.dec(priceChanges.avgRisePct, 1)}%, що додало ${costAdded} млн грн собівартості у 2025 році. За початковими цінами маржа майже не змінилась би: ${pct(first2024.pctAtFirstCost)} у 2024-му і ${pct(first2025.pctAtFirstCost)} у 2025-му. Фактично вона становить ${pct(y2024.pct)} і ${pct(y2025.pct)}.`,
    chartTitle: `З історією цін маржа падає на ${marginFallPp} п.п. За сьогоднішніми цінами падіння майже зникає.`,
    chartNote: `Без історії цін обидва роки рахуються за сьогоднішньою собівартістю, і виходить ${pct(current2024.pct)} та ${pct(current2025.pct)}. Спочатку сховище теж рахувало так, і ця помилка ховала падіння. Наприкінці лінії сходяться, бо останні продажі вже йдуть за сьогоднішніми цінами.`,

    exampleLink: 'Подивитись у звіті',
    questionsTitle: 'На що ще воно відповідає',
    questions: {
      discount: {
        who: 'Комерційний директор',
        question: 'Скільки нам коштують знижки?',
        answer: `${pct(discount.with.marginPct, 1)} проти ${pct(discount.without.marginPct, 1)}`,
        text: `Маржа на рядках зі знижкою проти решти. Знижку мають ${discountedShare}% рядків, разом ${fmt.dec(discount.with.discount / 1e6, 0)} млн грн. Дані показують нижчу маржу, але не те, чи окупаються знижки додатковими продажами. Для цього потрібен контрольний період.`,
        report: 'Подивитись у звіті',
      },
      products: {
        who: 'Категорійний менеджер',
        question: 'Які товари справді заробляють?',
        answer: `${fmt.int(products.a)} із ${fmt.int(totalProducts)}`,
        text: `Стільки товарів дають 80% виручки. Ще ${fmt.int(products.c)} дають лише ${fmt.dec(products.cSharePct, 0)}%, тож це перші кандидати на перегляд асортименту.`,
      },
      formats: {
        who: 'Операційний директор',
        question: 'Які формати магазинів працюють краще?',
        answer: `${perStore} млн`,
        text: 'Виручка на магазин у 2025 році: стандартний, флагман, кіоск. Флагмани заробляють на магазин менше, ніж стандартні.',
        report: 'Подивитись у звіті',
      },
      season: {
        who: 'Закупівлі',
        question: 'До чого готуватися в сезон?',
        answer: pct(season2025, 1),
        text: 'Частка річної виручки, що припадає на листопад і грудень, два місяці з дванадцяти. Запаси мають бути на місці до цього.',
        report: 'Подивитись у звіті',
      },
    },

    howTitle: 'Як чек стає відповіддю',
    howText: 'Кожна позиція чека стає одним рядком у таблиці фактів, а її ключі ведуть до вимірів: дата, товар, магазин, покупець. Усі відповіді вище це агрегати таких рядків. Натисніть на позицію в чеку, щоб побачити її рядок.',
    routesTitle: 'Детальніше',
    routes: [
      { path: '/report', title: 'Звіт', text: 'Дашборд із фільтрами за даними сховища: продажі, маржа, знижки, запаси.' },
      { path: '/journey', title: 'Шлях даних', text: 'Тривимірний політ: нитки несуть значення одного рядка чека з двох систем у дві зірки.' },
      { path: '/how', title: 'Як побудовано', text: 'Модель, рішення, від яких залежать цифри, тести й звірка.' },
    ],
  },
}[lang];

const QUESTIONS = [
  { ...COPY.questions.discount, focus: 'discount', sql: [insights.sql.discount] },
  { ...COPY.questions.products, sql: [insights.sql.products] },
  { ...COPY.questions.formats, focus: 'formats', sql: [insights.sql.formats] },
  { ...COPY.questions.season, focus: 'season', sql: [insights.sql.season] },
] as { who: string; question: string; answer: string; text: string; report?: string; focus?: string; sql: string[] }[];

// Opens the report with the filters set and the answering chart highlighted.
const reportAt = (focus: string) => `${localePath(lang, '/report')}?q=${focus}`;

---

<Base title={COPY.title} description={COPY.description} lang={lang}>
  <div class="shell page">
    <header class="flex flex-col gap-5">
      <p class="label">{t(lang, 'role')}</p>
      <h1 class="display display-1">Retail DWH</h1>
      <p class="lede">{COPY.lede}</p>
      <p class="note">{COPY.note}</p>
    </header>

    <section class="flex flex-col gap-4">
      <h2 class="display display-2">{COPY.solvesTitle}</h2>
      <p class="body">{COPY.solvesIntro}</p>
      <div class="solves">
        <div class="solves-head" aria-hidden="true">
          <span class="label">{COPY.colProblem}</span>
          <span class="label">{COPY.colDone}</span>
          <span class="label">{COPY.colGives}</span>
        </div>
        {COPY.problems.map((p) => (
          <div class="solves-row">
            <div class="flex flex-col gap-1">
              <h3 class="font-semibold leading-snug">{p.problem}</h3>
              <p class="text-[0.9375rem] leading-normal text-ink-2" set:html={p.why} />
            </div>
            <div>
              <p class="label solves-mobile">{COPY.colDone}</p>
              <p class="text-[0.9375rem] leading-normal" set:html={p.done} />
            </div>
            <div>
              <p class="label solves-mobile">{COPY.colGives}</p>
              <p class="text-[0.9375rem] leading-normal" set:html={p.gives} />
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="flex flex-col gap-4 border-t border-rule pt-8">
      <p class="label">{COPY.example}</p>
      <h2 class="display display-2">{COPY.exampleTitle}</h2>
      <p class="body">{COPY.exampleText}</p>
      <figure class="flex flex-col gap-3 pt-2">
        <figcaption class="max-w-[62ch] font-semibold text-balance text-ink">{COPY.chartTitle}</figcaption>
        <MarginChart lang={lang} />
      </figure>
      <p class="note">{COPY.chartNote}</p>
      <div class="flex flex-wrap gap-x-5 gap-y-1">
        <SqlDetails lang={lang} queries={[insights.sql.margin, insights.sql.priceEffect]} />
        <a class="link w-fit text-[0.9375rem] text-ink-2" href={reportAt('margin')}>{COPY.exampleLink}</a>
      </div>
    </section>

    <section class="flex flex-col gap-2">
      <h2 class="display display-2 pb-2">{COPY.questionsTitle}</h2>
      {QUESTIONS.map((q) => (
        <article class="question">
          <div class="flex flex-col gap-1">
            <p class="label">{q.who}</p>
            <h3 class="display display-3">{q.question}</h3>
            <p class="note pt-1">{q.text}</p>
            <div class="flex flex-wrap gap-x-5 gap-y-1 pt-1.5">
              <SqlDetails lang={lang} queries={q.sql} />
              {q.report && q.focus && <a class="link w-fit text-[0.9375rem] text-ink-2" href={reportAt(q.focus)}>{q.report}</a>}
            </div>
          </div>
          <p class="display answer">{q.answer}</p>
        </article>
      ))}
    </section>

    <section class="flex flex-col gap-6 border-t border-rule pt-8">
      <Receipt lang={lang}>
        <div class="flex flex-col gap-4">
          <h2 class="display display-2">{COPY.howTitle}</h2>
          <p class="body">{COPY.howText}</p>
        </div>
      </Receipt>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="label">{COPY.routesTitle}</h2>
      <nav class="grid gap-x-6 gap-y-4 md:grid-cols-3" aria-label={COPY.routesTitle}>
        {COPY.routes.map((r) => (
          <a href={localePath(lang, r.path)} class="route flex flex-col gap-1.5 border-t border-rule-strong py-3.5 transition-colors hover:border-ink">
            <span class="display text-[1.5625rem] leading-tight">{r.title}</span>
            <span class="text-[0.9375rem] leading-snug text-ink-2">{r.text}</span>
          </a>
        ))}
      </nav>
    </section>
  </div>
</Base>

<style>
  .solves-head,
  .solves-row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 4fr);
    gap: 0.75rem 2rem;
  }
  .solves-head { padding-bottom: 0.5rem; border-bottom: 1px solid var(--rule-strong); }
  .solves-row { padding-block: 1rem; border-bottom: 1px solid var(--rule); }
  .solves-mobile { display: none; }
  @media (max-width: 48rem) {
    .solves-head { display: none; }
    .solves-row { grid-template-columns: minmax(0, 1fr); }
    .solves-mobile { display: block; padding-bottom: 0.125rem; }
  }

  .question {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem 3rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .answer { font-size: clamp(1.625rem, 2.6vw, 2.125rem); text-align: right; white-space: nowrap; }
  @media (max-width: 48rem) {
    .question { grid-template-columns: minmax(0, 1fr); }
    .answer { text-align: left; order: -1; }
  }
</style>
