---
import Base from '~/layouts/Base.astro';
import Receipt from '~/components/Receipt.astro';
import Pipeline from '~/components/Pipeline.astro';
import { type Locale, localePath, t } from '~/i18n';
import { formatter } from '~/lib/format';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const fmt = formatter(lang);

// Page copy lives here rather than in the UI dictionary: it is prose, and prose
// is easier to keep honest when the two languages sit side by side.
const COPY = {
  en: {
    title: 'Overview',
    description: 'A dimensional data warehouse for a retail chain: two source systems, two fact tables on shared dimensions, a dbt layer and a clickable report.',
    lede: 'A data warehouse for a retail chain. Two source systems, two fact tables on shared dimensions, product history, a dbt layer and a report you can click through.',
    note: 'The data is generated by a script, so there is no real company behind it. The generator is deterministic, so every figure on this site can be reproduced.',
    sales: 'sales rows in <code>fact_sales</code>',
    stock: 'daily stock snapshots in <code>fact_inventory</code>',
    tests: 'dbt tests pass',
    diff: 'difference in totals between the manual model and the dbt model',
    caption: 'The model is built twice, by hand in SQL and in dbt, so the two can be compared. Sales match to the kopiyka.',
    routes: [
      { path: '/report', title: 'Report', text: 'A dashboard with filters over the warehouse data. You can click through it.' },
      { path: '/model', title: 'Model', text: 'Two fact tables of different types on shared dimensions, a diagram and a matrix.' },
      { path: '/decisions', title: 'Decisions', text: 'Five decisions the numbers depend on, with examples from this data.' },
      { path: '/results', title: 'Results', text: 'Reconciliation, tests, star against snowflake, and what reconciliation missed.' },
    ],
    stack: 'Stack',
    run: 'Run it yourself',
    runComment: '# loading src and wms: commands in the README',
  },
  uk: {
    title: 'Огляд',
    description: 'Вимірювальне сховище даних для роздрібної мережі: дві системи-джерела, два факти зі спільними вимірами, шар dbt і інтерактивний звіт.',
    lede: 'Сховище даних для роздрібної мережі. Дві системи-джерела, два факти зі спільними вимірами, історія змін товарів, шар dbt і звіт, який можна поклікати.',
    note: 'Дані згенеровані скриптом, реальної компанії за ними немає. Генератор детермінований, тому всі цифри на сайті можна отримати повторно.',
    sales: 'рядків продажів у <code>fact_sales</code>',
    stock: 'денних зрізів залишків у <code>fact_inventory</code>',
    tests: 'тестів dbt проходять',
    diff: 'різниця сум між ручною моделлю і моделлю dbt',
    caption: 'Модель зібрана двічі: вручну на SQL і в dbt. Так я можу порівняти результати між собою. Продажі збігаються до копійки.',
    routes: [
      { path: '/report', title: 'Звіт', text: 'Дашборд із фільтрами за даними сховища. Його можна поклікати.' },
      { path: '/model', title: 'Модель', text: 'Два факти різного типу на спільних вимірах, схема і матриця.' },
      { path: '/decisions', title: 'Рішення', text: 'П’ять рішень, від яких залежать цифри, з прикладами на цих даних.' },
      { path: '/results', title: 'Результати', text: 'Звірки, тести, порівняння зірки зі сніжинкою і те, чого звірка не ловить.' },
    ],
    stack: 'Стек',
    run: 'Запустити самому',
    runComment: '# наповнення src і wms: команди в README',
  },
}[lang];

const FIGURES = [
  { value: fmt.int(233015), text: COPY.sales },
  { value: fmt.int(254124), text: COPY.stock },
  { value: '76 / 76', text: COPY.tests },
  { value: fmt.dec(0, 2), text: COPY.diff },
];
---

<Base title={COPY.title} description={COPY.description} lang={lang}>
  <div class="shell page">
    <Receipt lang={lang}>
      <div class="flex flex-col gap-5">
        <p class="label">{t(lang, 'role')}</p>
        <h1 class="display display-1">Retail DWH</h1>
        <p class="lede">{COPY.lede}</p>
        <p class="note">{COPY.note}</p>
      </div>
    </Receipt>

    <dl class="grid grid-cols-2 gap-6 border-y border-rule py-6 md:grid-cols-4">
      {FIGURES.map((f) => (
        <div class="flex flex-col-reverse justify-end gap-2">
          <dt class="text-[0.90625rem] leading-snug text-ink-2" set:html={f.text} />
          <dd class="display text-[clamp(2.125rem,4vw,2.875rem)]">{f.value}</dd>
        </div>
      ))}
    </dl>

    <figure class="flex flex-col gap-3">
      <Pipeline lang={lang} />
      <figcaption class="note">{COPY.caption}</figcaption>
    </figure>

    <nav class="grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
      {COPY.routes.map((r) => (
        <a href={localePath(lang, r.path)} class="route flex flex-col gap-1.5 border-t border-rule-strong py-3.5 transition-colors hover:border-ink">
          <span class="display text-[1.5625rem] leading-tight">{r.title}</span>
          <span class="text-[0.9375rem] leading-snug text-ink-2">{r.text}</span>
        </a>
      ))}
    </nav>

    <div class="grid gap-8 md:grid-cols-2 md:gap-12">
      <div class="flex flex-col gap-2">
        <p class="label">{COPY.stack}</p>
        <p class="lede">PostgreSQL 16, dbt 1.12, Power BI, Docker</p>
      </div>
      <div class="flex flex-col gap-2">
        <p class="label">{COPY.run}</p>
        <pre class="code-block">docker compose up -d
{COPY.runComment}
cd 06_dbt && ./dbt.cmd build</pre>
      </div>
    </div>
  </div>
</Base>
