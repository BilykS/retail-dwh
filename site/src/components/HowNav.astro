---
import { type Locale, DEFAULT_LOCALE, localePath, pathWithoutLocale, t } from '~/i18n';

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props;

const LINKS = [
  { path: '/how', label: t(lang, 'nav.howOverview') },
  { path: '/model', label: t(lang, 'nav.model') },
  { path: '/decisions', label: t(lang, 'nav.decisions') },
  { path: '/results', label: t(lang, 'nav.results') },
];
const bare = pathWithoutLocale(Astro.url.pathname);
---

<nav class="flex flex-wrap items-baseline gap-x-5 gap-y-1 border-b border-rule pb-3" aria-label={t(lang, 'nav.howSection')}>
  {LINKS.map((l) => (
    <a
      href={localePath(lang, l.path)}
      aria-current={bare === l.path ? 'page' : undefined}
      class:list={[
        'text-[0.9375rem] whitespace-nowrap transition-colors',
        bare === l.path ? 'font-semibold text-ink' : 'text-ink-2 hover:text-ink',
      ]}
    >
      {l.label}
    </a>
  ))}
</nav>
